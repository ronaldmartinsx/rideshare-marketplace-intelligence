/// Origem-destino por mês × zona de origem × zona de destino × operadora (soma da fct_od_diario, decisão D2). Base das corridas que entram no CBD. A origem vem da dim_zona e o destino, da dim_zona_destino. Fonte: gold.fct_od_mensal.
table fct_od_mensal
	lineageTag: 59385602-9b8f-419b-89d0-538dac752ed5

	/// Corridas válidas da fct_od_mensal (grão mensal com origem e destino). No total, igual a [Corridas] da demanda.
	measure 'Corridas OD' = SUM(fct_od_mensal[qtd_corridas])
		formatString: #,##0
		displayFolder: Origem-destino
		lineageTag: ed09d30d-3daf-4fb6-91cc-7c4095d310be

	/// Corridas com destino no CBD e origem fora dele (dim_zona_destino[is_cbd_destino] e não dim_zona[is_cbd]). jan/2025 mistura 4 dias antes da taxa.
	measure 'Corridas entrando no CBD' =
			
			CALCULATE (
			    [Corridas OD],
			    KEEPFILTERS ( dim_zona_destino[is_cbd_destino] = TRUE () ),
			    KEEPFILTERS ( dim_zona[is_cbd] = FALSE () )
			)
		formatString: #,##0
		displayFolder: CBD
		lineageTag: 584d4392-b17c-4324-a579-f6ec6388fc8c

	/// Trecho da raia 3: de qual distrito de origem veio a variação das corridas que entram no CBD (maior variação absoluta por dia, 12 meses antes × depois da taxa) e quais ficaram estáveis (±2%), entre os distritos com 2%+ do volume. Ignora filtros. Medida de apresentação (Claude, ADR 0023).
	measure 'Texto R3 Origens' =
			VAR fmt = "pt-BR"
			VAR d = [Data Taxa CBD]
			VAR m0 = DATE ( YEAR ( d ), MONTH ( d ), 1 )
			VAR antes = FILTER ( ALL ( dim_mes[mes_inicio] ), dim_mes[mes_inicio] >= EDATE ( m0, -12 ) && dim_mes[mes_inicio] < m0 )
			VAR depois = FILTER ( ALL ( dim_mes[mes_inicio] ), dim_mes[mes_inicio] >= m0 && dim_mes[mes_inicio] < EDATE ( m0, 12 ) )
			VAR dias_a = SUMX ( antes, DAY ( EOMONTH ( dim_mes[mes_inicio], 0 ) ) )
			VAR dias_d = SUMX ( depois, DAY ( EOMONTH ( dim_mes[mes_inicio], 0 ) ) )
			VAR total_a = CALCULATE ( [Corridas entrando no CBD], REMOVEFILTERS (), antes )
			VAR total_d = CALCULATE ( [Corridas entrando no CBD], REMOVEFILTERS (), depois )
			VAR sinal = IF ( total_d / dias_d < total_a / dias_a, -1, 1 )
			VAR b =
			    FILTER (
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                VALUES ( dim_zona[borough] ),
			                "@a", CALCULATE ( [Corridas entrando no CBD], antes ) / dias_a,
			                "@d", CALCULATE ( [Corridas entrando no CBD], depois ) / dias_d
			            ),
			            REMOVEFILTERS ()
			        ),
			        [@a] * dias_a >= 0.02 * total_a
			    )
			VAR t = ADDCOLUMNS ( b, "@v", DIVIDE ( [@d], [@a] ) - 1, "@delta", [@d] - [@a] )
			VAR lider = TOPN ( 1, FILTER ( t, [@delta] * sinal > 0 ), [@delta] * sinal, DESC )
			VAR nome_lider = MAXX ( lider, dim_zona[borough] )
			VAR de_lider = SWITCH ( nome_lider, "Manhattan", "do resto de Manhattan", "Staten Island", "de Staten Island", "do " & nome_lider )
			VAR estaveis = FILTER ( t, ABS ( [@v] ) <= 0.02 && dim_zona[borough] <> nome_lider )
			VAR lista = CONCATENATEX ( estaveis, dim_zona[borough], ", ", [@a], DESC )
			VAR n_est = COUNTROWS ( estaveis )
			VAR lista_e = IF ( n_est > 1, SUBSTITUTE ( lista, ", ", " e ", n_est - 1 ), lista )
			RETURN
			    IF (
			        NOT ISEMPTY ( lider ),
			        "A " & IF ( sinal < 0, "queda", "alta" ) & " veio " & de_lider & " (" & FORMAT ( MAXX ( lider, [@v] ), "+0.0%;−0.0%", fmt ) & " nas corridas que entram no CBD)"
			            & IF ( n_est > 0, "; " & lista_e & IF ( n_est > 1, " ficaram estáveis", " ficou estável" ) )
			    )
		displayFolder: Apresentacao
		lineageTag: c1e55890-e72a-4b72-83e4-a7039ca9f2ab

	/// Subtítulo do mapa de origem das corridas que entram no CBD: os 3 distritos que mais mandam corridas para o CBD no período escolhido, com a fatia de cada um. Segue o filtro. Medida de apresentação (Claude, ADR 0023).
	measure 'Subtitulo Origem CBD Mapa' =
			VAR fmt = "pt-BR"
			VAR total = [Corridas entrando no CBD]
			VAR b = FILTER ( ADDCOLUMNS ( VALUES ( dim_zona[borough] ), "@n", [Corridas entrando no CBD] ), [@n] > 0 )
			VAR top3 = TOPN ( 3, b, [@n], DESC )
			VAR t = ADDCOLUMNS ( top3, "@r", RANKX ( top3, [@n], , DESC ), "@s", DIVIDE ( [@n], total ) )
			VAR nome1 = MAXX ( FILTER ( t, [@r] = 1 ), dim_zona[borough] )
			-- formato curto (cabe nos ~546 px do mapa): "Maiores origens: resto de Manhattan 37%, Brooklyn 30%, Queens 27%"
			VAR lista =
			    CONCATENATEX (
			        t,
			        IF ( dim_zona[borough] = "Manhattan", "resto de Manhattan", dim_zona[borough] ) & " " & FORMAT ( [@s], "0%", fmt ),
			        ", ",
			        [@n], DESC
			    )
			RETURN
			    IF ( NOT ISBLANK ( nome1 ), IF ( COUNTROWS ( t ) > 1, "Maiores origens: ", "Maior origem: " ) & lista )
		displayFolder: Apresentacao
		lineageTag: 9878eb5a-9981-4be2-ac31-090346078d80

	/// Subtítulo das corridas que entram no CBD por distrito de origem: quais distritos (com 2%+ do volume) reduziram mais de 2% por dia depois de [Data Taxa CBD], dentro do período escolhido. Segue o filtro. Medida de apresentação (Claude, ADR 0023).
	measure 'Subtitulo Origem CBD Distritos' =
			VAR fmt = "pt-BR"
			VAR d = [Data Taxa CBD]
			VAR m0 = DATE ( YEAR ( d ), MONTH ( d ), 1 )
			VAR meses = FILTER ( VALUES ( dim_mes[mes_inicio] ), [Corridas OD] > 0 )
			VAR antes = FILTER ( meses, dim_mes[mes_inicio] < m0 )
			VAR depois = FILTER ( meses, dim_mes[mes_inicio] >= m0 )
			VAR dias_a = SUMX ( antes, DAY ( EOMONTH ( dim_mes[mes_inicio], 0 ) ) )
			VAR dias_d = SUMX ( depois, DAY ( EOMONTH ( dim_mes[mes_inicio], 0 ) ) )
			VAR total = [Corridas entrando no CBD]
			VAR b =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_zona[borough] ),
			            "@n", [Corridas entrando no CBD],
			            "@v", DIVIDE ( CALCULATE ( [Corridas entrando no CBD], depois ) / dias_d, CALCULATE ( [Corridas entrando no CBD], antes ) / dias_a ) - 1
			        ),
			        [@n] >= 0.02 * total
			    )
			VAR cairam = FILTER ( b, [@v] < -0.02 )
			VAR n = COUNTROWS ( cairam )
			VAR lista = CONCATENATEX ( cairam, dim_zona[borough] & " (" & FORMAT ( [@v], "+0.0%;−0.0%", fmt ) & ")", ", ", [@v], ASC )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISEMPTY ( antes ) || ISEMPTY ( depois ), "A taxa começou em " & FORMAT ( d, "dd/mm/yyyy" ) & "; escolha um período que inclua antes e depois",
			        n = 0, "Nenhum distrito reduziu mais de 2% por dia após a taxa",
			        n = 1, "Só " & MAXX ( cairam, dim_zona[borough] ) & " reduziu: " & FORMAT ( MAXX ( cairam, [@v] ), "+0.0%;−0.0%", fmt ) & " por dia após a taxa",
			        "Reduziram por dia após a taxa: " & lista
			    )
		displayFolder: Apresentacao
		lineageTag: 28abfb74-a879-49b0-8df5-d0c32a95732b

