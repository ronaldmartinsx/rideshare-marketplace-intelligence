/// Demanda por hora de embarque (hora local de Nova York) × zona de origem × operadora. Só corridas válidas. As somas econômicas (tarifa, repasse, milhas e segundos) usam só as corridas com tarifa válida (> 0). Fonte: gold.fct_demanda_zona_hora (dbt).
table fct_demanda_zona_hora
	lineageTag: 079a40e8-eefc-45e1-b8f3-45485aa20d1d

	/// Corridas válidas (spec 2.5). Contrato: sum(qtd_corridas).
	measure Corridas = SUM(fct_demanda_zona_hora[qtd_corridas])
		formatString: #,##0
		displayFolder: Volume
		lineageTag: 9ffa9551-2c05-432c-b67c-281e263e6986

	/// Corridas válidas com tarifa base > 0. É a base de todas as métricas de economia.
	measure 'Corridas com tarifa valida' = SUM(fct_demanda_zona_hora[qtd_corridas_tarifa_valida])
		formatString: #,##0
		displayFolder: Volume
		lineageTag: fd2509a3-fba5-4650-9b98-6b219afe0cc0

	/// Parcela das corridas válidas com tarifa ≤ 0, que ficam fora das métricas de economia (Fase 4, passo 1). Mostrar na página de economia.
	measure '% tarifa invalida' = DIVIDE( [Corridas] - [Corridas com tarifa valida], [Corridas])
		formatString: 0.00%
		displayFolder: Economia
		lineageTag: 7bb5660e-0e95-4249-88d1-fdf47dd2018d

	/// (Tarifa − Repasse) / Tarifa. Razão das somas, nunca média de take rates. Só corridas com tarifa válida. Impostos, taxas, pedágios e gorjetas ficam fora (spec 2.5).
	measure 'Take rate' = DIVIDE( [Tarifa] - [Repasse], [Tarifa])
		formatString: 0.0%
		displayFolder: Economia
		lineageTag: 918afd29-ab09-4867-882f-4ae9241d43f5

	/// Soma da tarifa base (base_passenger_fare) das corridas com tarifa válida. Medida base das métricas de economia.
	measure Tarifa = SUM(fct_demanda_zona_hora[tarifa_base_total])
		formatString: $#,##0
		displayFolder: Base
		lineageTag: abbc8a97-8001-4c6c-8e78-89236582c14b

	/// Soma do repasse ao motorista (driver_pay) das corridas com tarifa válida. Exclui pedágios e gorjetas. Medida base.
	measure Repasse = SUM(fct_demanda_zona_hora[repasse_motorista_total])
		formatString: $#,##0
		displayFolder: Base
		lineageTag: 96db544b-27e0-4137-931f-1bb3d968f16a

	/// Soma das milhas das corridas com tarifa válida. Medida base.
	measure 'Milhas com tarifa valida' = SUM(fct_demanda_zona_hora[milhas_tarifa_valida_total])
		formatString: #,##0.0
		displayFolder: Base
		lineageTag: d6856893-5105-468f-9c1f-e242d70491d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Tarifa / milhas, nas mesmas corridas (tarifa válida).
	measure 'Receita por milha' = DIVIDE([Tarifa], [Milhas com tarifa valida])
		formatString: $#,##0.00
		displayFolder: Economia
		lineageTag: fcf4b0d8-128a-4b7e-97b7-da5fe25c4c0e

	/// Tarifa / (segundos / 60), nas mesmas corridas (tarifa válida). Entrou no contrato em 02/11/2026.
	measure 'Receita por minuto' =
			
			VAR numerador = [Tarifa]
			VAR denominador = DIVIDE([Segundos tarifa valida], 60)
			
			RETURN
			DIVIDE(numerador, denominador)
		formatString: $#,##0.00
		displayFolder: Economia
		lineageTag: a2757cbc-8ae6-46d6-b8ac-ce27e1fd44f4

	/// Soma do tempo de corrida, em segundos, das corridas com tarifa válida. Medida base.
	measure 'Segundos tarifa valida' = SUM(fct_demanda_zona_hora[segundos_tarifa_valida_total])
		formatString: #,##0
		displayFolder: Base
		lineageTag: f7b8b3f3-e782-4629-819b-66c32a50637b

	/// Repasse / (segundos / 3600). NÃO é o ganho por hora do motorista: o dado não tem tempo ocioso nem identificador de motorista.
	measure 'Repasse por hora de corrida' =
			
			VAR numerador = [Repasse]
			VAR denominador = DIVIDE([Segundos tarifa valida], 3600)
			
			RETURN
			DIVIDE(numerador, denominador)
		formatString: $#,##0.00
		displayFolder: Economia
		lineageTag: 3b9a7d0e-09fa-44f4-bd62-2ddead75b440

	/// Corridas do recorte atual (zona, período, hora) somando todas as operadoras: denominador do share. Remove só o filtro da dim_operadora.
	measure 'Corridas do mesmo recorte' = CALCULATE([Corridas], REMOVEFILTERS(dim_operadora))
		formatString: #,##0
		displayFolder: Base
		lineageTag: 31f6511b-c4ad-44c5-b6de-7b2883b0514f

	/// Corridas da operadora / corridas de todas as operadoras no mesmo recorte de zona e período (spec 2.5). Num visual sem operadora, vale 100%.
	measure 'Share da operadora' = DIVIDE([Corridas], [Corridas do mesmo recorte])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Share
		lineageTag: 08c88f9e-0f02-4f78-bfed-2ea8233d5f39

	/// Corridas com destino numa das 38 zonas do CBD (lista da MTA, ADR 0007), pela zona de origem desta fato. Antes × depois: corte em 05/01/2025; não usar a taxa cbd_congestion_fee.
	measure 'Corridas com destino no CBD' = SUM(fct_demanda_zona_hora[qtd_corridas_destino_cbd])
		formatString: #,##0
		displayFolder: CBD
		lineageTag: dd042ad7-447b-4177-b3e5-63ef00957586

	/// Corridas com destino no CBD / Corridas, no mesmo recorte.
	measure '% destino no CBD' = DIVIDE([Corridas com destino no CBD], [Corridas])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CBD
		lineageTag: 8bd8000f-beed-4b9e-b02a-3277ed9aec20

	/// Faixa de 6 cartões KPI em HTML para o visual HTML Content (abertura do relatório). Ao passar o mouse, cada cartão mostra o que é o número e como é calculado. Medida de apresentação escrita pelo Claude (exceção à regra ✍️ autorizada pelo Ronald em 05/11/2026).
	measure 'HTML Cartoes KPI' =
			VAR fmt = "pt-BR"
			VAR corridas = [Corridas]
			VAR dias = COUNTROWS ( FILTER ( VALUES ( dim_tempo_hora[data] ), CALCULATE ( [Corridas] ) > 0 ) )
			VAR por_dia = DIVIDE ( corridas, dias )
			VAR p90 = [Espera P90 (min)]
			VAR p90_u = CALCULATE ( [Espera P90 (min)], dim_operadora[operadora_id] = "HV0003" )
			VAR p90_l = CALCULATE ( [Espera P90 (min)], dim_operadora[operadora_id] = "HV0005" )
			VAR take = [Take rate]
			VAR take_u = CALCULATE ( [Take rate], dim_operadora[operadora_id] = "HV0003" )
			VAR take_l = CALCULATE ( [Take rate], dim_operadora[operadora_id] = "HV0005" )
			VAR rmilha = [Receita por milha]
			VAR rmin = [Receita por minuto]
			VAR pcbd = [% destino no CBD]
			VAR entrando = [Corridas entrando no CBD]
			VAR share_l = CALCULATE ( [Share da operadora], dim_operadora[operadora_id] = "HV0005" )
			VAR share_u = CALCULATE ( [Share da operadora], dim_operadora[operadora_id] = "HV0003" )
			-- um cartão: rótulo, valor, contexto e a explicação que aparece ao passar o mouse
			VAR estilo = "<style>"
			    & ".kpis{display:flex;gap:12px;height:150px;font-family:'Segoe UI',sans-serif;box-sizing:border-box}"
			    & ".k{flex:1;position:relative;background:#FFFFFF;border:1px solid #E1DFDD;border-left-width:5px;border-radius:8px;padding:14px 16px;overflow:hidden;cursor:help}"
			    & ".l{font-size:12px;color:#605E5C;text-transform:uppercase;letter-spacing:.04em}"
			    & ".v{font-size:32px;font-weight:600;color:#1F1F1F;margin:6px 0 4px}"
			    & ".c{font-size:12px;color:#605E5C}"
			    & ".t{display:none;position:absolute;top:0;left:0;right:0;bottom:0;background:#1B2A41;color:#FFFFFF;font-size:12px;line-height:1.45;padding:12px 14px}"
			    & ".k:hover .t{display:block}"
			    & "</style>"
			VAR c1 = "<div class='k' style='border-left-color:#4D4D4D'><div class='l'>Corridas</div><div class='v'>" & FORMAT ( corridas / 1e6, "#,##0", fmt ) & " mi</div><div class='c'>média de " & FORMAT ( por_dia / 1e3, "#,##0", fmt ) & " mil por dia</div><div class='t'><b>Corridas válidas</b> de alto volume (Uber, Lyft e inativas) no período. Soma de qtd_corridas da Gold; as inválidas ficam na Silver com o motivo.</div></div>"
			VAR c2 = "<div class='k' style='border-left-color:#D55E00'><div class='l'>Espera P90</div><div class='v'>" & FORMAT ( p90, "0.0", fmt ) & " min</div><div class='c'>Uber " & FORMAT ( p90_u, "0.0", fmt ) & " · Lyft " & FORMAT ( p90_l, "0.0", fmt ) & " min</div><div class='t'><b>90% das corridas</b> esperaram até este tempo, do pedido ao embarque. Recalculado das faixas do histograma em qualquer recorte (ADR 0006); acima de 15 min é aproximado.</div></div>"
			VAR c3 = "<div class='k' style='border-left-color:#0072B2'><div class='l'>Take rate</div><div class='v'>" & FORMAT ( take, "0.0%", fmt ) & "</div><div class='c'>Uber " & FORMAT ( take_u, "0.0%", fmt ) & " · Lyft " & FORMAT ( take_l, "0.0%", fmt ) & "</div><div class='t'><b>Parte da tarifa que fica com a operadora:</b> (tarifa base − repasse ao motorista) ÷ tarifa base, somando antes de dividir. Só corridas com tarifa maior que zero.</div></div>"
			VAR c4 = "<div class='k' style='border-left-color:#0072B2'><div class='l'>Receita por milha</div><div class='v'>US$ " & FORMAT ( rmilha, "0.00", fmt ) & "</div><div class='c'>por minuto: US$ " & FORMAT ( rmin, "0.00", fmt ) & "</div><div class='t'><b>Tarifa base ÷ milhas</b>, nas mesmas corridas (tarifa maior que zero). Não inclui impostos, taxas, pedágios nem gorjetas.</div></div>"
			VAR c5 = "<div class='k' style='border-left-color:#009E73'><div class='l'>Destino no CBD</div><div class='v'>" & FORMAT ( pcbd, "0.0%", fmt ) & "</div><div class='c'>" & FORMAT ( entrando / 1e6, "#,##0.0", fmt ) & " mi entraram vindas de fora</div><div class='t'><b>Corridas que terminam no CBD</b> (38 zonas da Congestion Relief Zone, lista da MTA) ÷ todas as corridas. A taxa de congestionamento vale desde 05/01/2025.</div></div>"
			VAR c6 = "<div class='k' style='border-left-color:#CC79A7'><div class='l'>Share da Lyft</div><div class='v'>" & FORMAT ( share_l, "0.0%", fmt ) & "</div><div class='c'>Uber: " & FORMAT ( share_u, "0.0%", fmt ) & "</div><div class='t'><b>Corridas da Lyft ÷ corridas de todas as operadoras</b> no mesmo recorte de zona e período.</div></div>"
			RETURN
			    estilo & "<div class='kpis'>" & c1 & c2 & c3 & c4 & c5 & c6 & "</div>"
		displayFolder: Apresentacao
		lineageTag: 04372dd3-85fa-499f-80a2-ab3deb7acdd1

