	partition fct_demanda_zona_hora = m
		mode: import
		source =
				let
				    Source = AmazonAthena.Databases("rideshare-athena", null, []),
				    AwsDataCatalog_Database = Source{[Name="AwsDataCatalog",Kind="Database"]}[Data],
				    gold_Schema = AwsDataCatalog_Database{[Name="gold",Kind="Schema"]}[Data],
				    fct_demanda_zona_hora_Table = gold_Schema{[Name="fct_demanda_zona_hora",Kind="Table"]}[Data]
				in
				    fct_demanda_zona_hora_Table

