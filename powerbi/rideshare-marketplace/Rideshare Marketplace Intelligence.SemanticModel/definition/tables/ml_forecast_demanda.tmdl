/// Previsão de demanda do LightGBM: hora-alvo × zona × execução. Traz o realizado na mesma linha (vazio na produção). tipo_rodada separa backtest (tem gabarito) de producao (não tem). Filtre sempre UMA execução pela dim_execucao. Fonte: gold.ml_forecast_demanda (Fase 5).
table ml_forecast_demanda
	lineageTag: 9f4d9fb0-4966-4261-84eb-d565f140cf55

	/// Soma da previsão do modelo (previsao) em todas as linhas do contexto: backtest e produção, sempre de UMA execução ([Execucao Alvo]: a selecionada ou a padrão), porque somar execuções duplica o resultado. Para comparar com o realizado, use [Previsão Backtest]. Lógica do Ronald; filtro de execução padrão pelo Claude (ADR 0023).
	measure 'Previsão Total' =
			VAR alvo = [Execucao Alvo]
			RETURN
			    CALCULATE ( SUM ( ml_forecast_demanda[previsao] ), dim_execucao[execucao] = alvo )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 069c75fd-f5f7-469d-ab45-ac99d730f461

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Previsão do mês de produção (tipo_rodada = producao), que ainda não tem realizado publicado pela TLC (~2 meses de atraso). Ex.: 22.156.449 corridas para out/2026 na execução oficial.
	measure 'Previsão Produção' = CALCULATE( [Previsão Total], ml_forecast_demanda[tipo_rodada] = "producao" )
		formatString: #,##0
		displayFolder: Previsão
		lineageTag: b365a4a0-bc72-458b-809c-944ea4174f5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Corridas que de fato aconteceram (qtd_corridas_real), na mesma linha da previsão. Vazio na produção: BLANK quer dizer desconhecido, não zero. Sempre de uma execução ([Execucao Alvo]).
	measure Realizado =
			VAR alvo = [Execucao Alvo]
			RETURN
			    CALCULATE ( SUM ( ml_forecast_demanda[qtd_corridas_real] ), dim_execucao[execucao] = alvo )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 354aaf43-fbf7-4f35-b8b8-5be1bed63916

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Soma, linha a linha (zona × hora), de |previsão − realizado|, só nas linhas com realizado. Não é a diferença das somas (isso seria o viés). Sem o filtro de realizado, o BLANK viraria 0 e a produção somaria a previsão inteira como erro.
	measure 'Erro Absoluto' =
			VAR alvo = [Execucao Alvo]
			RETURN
			    CALCULATE (
			        SUMX (
			            FILTER ( ml_forecast_demanda, NOT ISBLANK ( ml_forecast_demanda[qtd_corridas_real] ) ),
			            ABS ( ml_forecast_demanda[previsao] - ml_forecast_demanda[qtd_corridas_real] )
			        ),
			        dim_execucao[execucao] = alvo
			    )
		formatString: #,##0
		displayFolder: Base
		lineageTag: c370d0dc-cfbe-411e-acd2-37c0c057c34c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Erro percentual ponderado: [Erro Absoluto] / [Realizado], razão das somas. É o WAPE agrupado do recorte (12,91% nas 6 rodadas oficiais); num mês só, bate com wape_modelo da ml_backtest_metricas (reconciliado DAX × Python nos 6 meses).
	measure WAPE = DIVIDE([Erro Absoluto], [Realizado])
		formatString: 0.00%
		displayFolder: Previsão
		lineageTag: e484c40b-a7ac-4496-93f0-f75e7b585c5a

	/// ([Previsão Backtest] − [Realizado]) / [Realizado]. Negativo = o modelo subestima. Nas 6 rodadas oficiais, −2,38%: consequência da perda L1, que mira a mediana.
	measure 'Viés %' = DIVIDE([Previsão Backtest] - [Realizado], [Realizado])
		formatString: 0.00%
		displayFolder: Previsão
		lineageTag: 57bea2d9-5c34-4db8-8b2b-d69e8c3c0862

	/// Previsão só das rodadas de backtest (tipo_rodada = backtest), as que têm realizado para comparar. Base do [Viés %]: sem esse filtro, a previsão de produção (sem gabarito) inflaria o numerador.
	measure 'Previsão Backtest' = CALCULATE( [Previsão Total], ml_forecast_demanda[tipo_rodada] = "backtest" )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 56983863-b117-48ae-8f49-579ec6129710

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Qual execução do modelo está no ar (data e hora UTC), se é a padrão (sem seleção: a de mais janelas testadas), as rodadas de backtest e o total de execuções. Medida de apresentação (Claude, ADR 0023).
	measure 'HTML Execucao no Ar' =
			VAR sel = SELECTEDVALUE ( dim_execucao[execucao] )
			VAR e = [Execucao Alvo]
			VAR total = COUNTROWS ( ALL ( dim_execucao ) )
			VAR quando =
			    MID ( e, 7, 2 ) & "/" & MID ( e, 5, 2 ) & "/" & LEFT ( e, 4 )
			        & " " & MID ( e, 10, 2 ) & ":" & MID ( e, 12, 2 ) & " UTC"
			VAR rod = COALESCE ( [Rodadas Testadas], 0 )
			VAR origem = IF ( ISBLANK ( sel ), " (padrão: a de mais janelas testadas)" )
			VAR estilo = "font-family:Segoe UI,sans-serif;font-size:11px;line-height:1.5;"
			RETURN
			    "<div style='" & estilo & "color:#44546A'>Execução do modelo no ar: <b style='color:#1F2A37'>" & quando & "</b>" & origem & " · "
			        & rod & IF ( rod = 1, " rodada", " rodadas" ) & " de backtest · "
			        & total & " execuções disponíveis. Troque na segmentação para comparar versões.</div>"
		displayFolder: Apresentacao
		lineageTag: 8ea8c195-c338-41c5-b7f0-b5f13e9c86c9

	/// As 3 limitações da previsão (viés, clima observado, atraso da TLC), em linguagem de negócio. O viés vem de [Viés %] nas rodadas da execução selecionada, ignorando os demais filtros. Medida de apresentação (Claude).
	measure 'HTML Limitacoes' =
			VAR v =
			    CALCULATE ( [Viés %], REMOVEFILTERS (), VALUES ( dim_execucao[execucao] ) )
			VAR vies =
			    IF ( ISBLANK ( v ), "cerca de 2,4%", FORMAT ( ABS ( v ), "0.0%", "pt-BR" ) )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;font-size:11px;line-height:1.55;color:#44546A'>"
			    & "<b style='color:#1F2A37'>O que este resultado não diz</b><br>"
			    & "<b>1. O modelo erra para baixo</b> em " & vies & " no total: ele foi treinado para acertar o valor típico (a mediana), não a média.<br>"
			    & "<b>2. O teste é otimista no clima:</b> usa o tempo que de fato fez. No uso real só haveria a previsão do tempo, com erro próprio.<br>"
			    & "<b>3. A previsão ainda não é operacional:</b> a TLC publica os dados com cerca de 2 meses de atraso, então o mês previsto já passou quando a previsão fica pronta. Está validada em backtest; em produção seria alimentada por dados em tempo real."
			    & "</div>"
		displayFolder: Apresentacao
		lineageTag: 1c14f4c1-f0be-462a-a303-0365fc69677d

	/// Faixa de 5 cartões da raia 5 em HTML, no padrão do HTML Cartoes KPI: erro do modelo, erro do palpite sazonal, vantagem, janelas vencidas e previsão do mês seguinte, da execução-alvo ([Execucao Alvo]). Ao passar o mouse, a explicação da métrica em linguagem de negócio. Medida de apresentação (Claude).
	measure 'HTML Cartoes Previsao' =
			VAR fmt = "pt-BR"
			VAR vazio = "—"
			VAR alvo = [Execucao Alvo]
			VAR wm = [WAPE Modelo]
			VAR wb = [WAPE Baseline]
			VAR g = [Ganho (pp)]
			VAR rel = DIVIDE ( g / 100, wb )
			VAR jan = [Texto Rodadas Vencidas]
			VAR n = [Rodadas Testadas]
			VAR prod = [Previsão Produção]
			-- meses do backtest e da produção da execução-alvo, para o texto (ex.: abr/2026 a set/2026)
			VAR ini = CALCULATE ( MIN ( ml_backtest_metricas[mes_alvo] ), ml_backtest_metricas[tipo] = "backtest", dim_execucao[execucao] = alvo )
			VAR fim = CALCULATE ( MAX ( ml_backtest_metricas[mes_alvo] ), ml_backtest_metricas[tipo] = "backtest", dim_execucao[execucao] = alvo )
			VAR mp = CALCULATE ( MAX ( ml_backtest_metricas[mes_alvo] ), ml_backtest_metricas[tipo] = "producao", dim_execucao[execucao] = alvo )
			VAR t_ini = IF ( NOT ISBLANK ( ini ), LOWER ( FORMAT ( DATE ( VALUE ( LEFT ( ini, 4 ) ), VALUE ( RIGHT ( ini, 2 ) ), 1 ), "MMM/yyyy", fmt ) ) )
			VAR t_fim = IF ( NOT ISBLANK ( fim ), LOWER ( FORMAT ( DATE ( VALUE ( LEFT ( fim, 4 ) ), VALUE ( RIGHT ( fim, 2 ) ), 1 ), "MMM/yyyy", fmt ) ) )
			VAR t_mp = IF ( NOT ISBLANK ( mp ), LOWER ( FORMAT ( DATE ( VALUE ( LEFT ( mp, 4 ) ), VALUE ( RIGHT ( mp, 2 ) ), 1 ), "MMM/yyyy", fmt ) ), "o mês seguinte" )
			-- valores já formatados
			VAR v1 = IF ( ISBLANK ( wm ), vazio, FORMAT ( wm, "0.00%", fmt ) )
			VAR v2 = IF ( ISBLANK ( wb ), vazio, FORMAT ( wb, "0.00%", fmt ) )
			VAR v3 = IF ( ISBLANK ( g ), vazio, FORMAT ( g, "0.00", fmt ) & " pp" )
			VAR v4 = IF ( ISBLANK ( jan ), vazio, jan )
			VAR v5 = IF ( ISBLANK ( prod ), vazio, FORMAT ( prod / 1e6, "#,##0.0", fmt ) & " mi" )
			VAR v_rel = IF ( ISBLANK ( rel ), vazio, FORMAT ( rel, "0.0%", fmt ) )
			VAR periodo = IF ( ISBLANK ( ini ), vazio, IF ( ini = fim, t_ini, t_ini & " a " & t_fim ) )
			-- ícones em SVG (traço na cor do cartão)
			VAR ic_alvo = "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='5'/><circle cx='12' cy='12' r='1'/>"
			VAR ic_regua = "<path d='M3 17L17 3l4 4L7 21z'/><path d='M7 13l2 2M10 10l2 2M13 7l2 2'/>"
			VAR ic_queda = "<path d='M3 7l6 6 4-4 8 8'/><path d='M21 11v6h-6'/>"
			VAR ic_check = "<circle cx='12' cy='12' r='9'/><path d='M8 12l3 3 5-6'/>"
			VAR ic_cal = "<rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4'/>"
			VAR svg0 = "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' stroke='"
			VAR estilo = "<style>"
			    & ".pk{display:flex;gap:12px;height:150px;font-family:'Segoe UI',sans-serif;box-sizing:border-box}"
			    & ".k{flex:1;position:relative;background:#FFFFFF;border:2px solid #E1DFDD;border-radius:10px;padding:12px 14px;overflow:hidden;cursor:help;box-sizing:border-box}"
			    & ".h{display:flex;justify-content:space-between;align-items:center}"
			    & ".l{font-size:12px;color:#605E5C;text-transform:uppercase;letter-spacing:.04em}"
			    & ".v{font-size:30px;font-weight:600;color:#1F1F1F;margin:6px 0 2px}"
			    & ".c{font-size:12px;color:#605E5C}"
			    & ".t{display:none;position:absolute;top:0;left:0;right:0;bottom:0;color:#FFFFFF;font-size:12px;line-height:1.45;padding:12px 14px}"
			    & ".k:hover .t{display:block}"
			    & "</style>"
			-- cartão: cor da borda/ícone, tom escuro do hover, rótulo, ícone, valor, contexto, explicação
			VAR c1 = "<div class='k' style='border-color:#4B5D99'><div class='h'><span class='l'>Erro do modelo</span>" & svg0 & "#4B5D99'>" & ic_alvo & "</svg></div><div class='v'>" & v1 & "</div><div class='c'>média de " & COALESCE ( n, 0 ) & " janelas testadas</div><div class='t' style='background:#36437A'><b>Erro percentual ponderado (WAPE):</b> a soma dos erros, hora a hora e zona a zona, dividida pelas corridas que de fato aconteceram. É a média das janelas de teste, cada uma com um mês que o modelo não viu no treino.</div></div>"
			VAR c2 = "<div class='k' style='border-color:#9AA5B1'><div class='h'><span class='l'>Erro do palpite sazonal</span>" & svg0 & "#9AA5B1'>" & ic_regua & "</svg></div><div class='v'>" & v2 & "</div><div class='c'>mesma hora, 4 semanas antes</div><div class='t' style='background:#5F6B78'><b>A régua do modelo:</b> o palpite mais simples que faz sentido, a média da mesma hora e dia da semana nas 4 semanas anteriores, sem nenhum treino. Um modelo que não vença este número não serve.</div></div>"
			VAR c3 = "<div class='k' style='border-color:#4B5D99'><div class='h'><span class='l'>Vantagem do modelo</span>" & svg0 & "#4B5D99'>" & ic_queda & "</svg></div><div class='v'>" & v3 & "</div><div class='c'>" & v_rel & " menos erro, relativo</div><div class='t' style='background:#36437A'><b>Quanto o modelo erra a menos</b> que o palpite sazonal, em pontos percentuais (" & v2 & " − " & v1 & "). Em termos relativos, são " & v_rel & " menos erro.</div></div>"
			VAR c4 = "<div class='k' style='border-color:#4B5D99'><div class='h'><span class='l'>Janelas vencidas</span>" & svg0 & "#4B5D99'>" & ic_check & "</svg></div><div class='v'>" & v4 & "</div><div class='c'>" & periodo & "</div><div class='t' style='background:#36437A'><b>Teste no passado (backtest):</b> em cada janela, o modelo treina com os dados até um mês e prevê o mês seguinte. Ele errou menos que o palpite sazonal em " & v4 & " janelas.</div></div>"
			VAR c5 = "<div class='k' style='border-color:#4B5D99'><div class='h'><span class='l'>Previsão " & t_mp & "</span>" & svg0 & "#4B5D99'>" & ic_cal & "</svg></div><div class='v'>" & v5 & "</div><div class='c'>corridas previstas no mês</div><div class='t' style='background:#36437A'><b>Previsão para o mês seguinte ao último dado:</b> " & IF ( ISBLANK ( prod ), vazio, FORMAT ( prod, "#,##0", fmt ) ) & " corridas. O realizado ainda não saiu (a TLC publica com cerca de 2 meses de atraso). Como o modelo erra para baixo no teste, o número real tende a ser um pouco maior.</div></div>"
			RETURN
			    estilo & "<div class='pk'>" & c1 & c2 & c3 & c4 & c5 & "</div>"
		displayFolder: Apresentacao
		lineageTag: 09fe8a2f-ebef-4f0d-ba88-123d5efcfc0a

	/// Erro do modelo no total do DIA na cidade: soma, dia a dia, de |previsão − realizado| ÷ realizado, só nos dias com realizado (backtest). Menor que o [WAPE] (zona × hora) porque, ao somar as zonas do dia, erros para cima e para baixo se compensam. Escrita pelo Claude (ADR 0023).
	measure 'WAPE Diario Cidade' =
			VAR dias =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_tempo_hora[data] ), "@p", [Previsão Backtest], "@r", [Realizado] ),
			        NOT ISBLANK ( [@r] )
			    )
			RETURN
			    DIVIDE ( SUMX ( dias, ABS ( [@p] - [@r] ) ), SUMX ( dias, [@r] ) )
		formatString: 0.0%
		displayFolder: Previsão
		lineageTag: 83436071-7a63-4dc2-b2f8-3903368718b5

	/// Abertura da raia 5 (pergunta e resposta) gerada pelos dados da execução selecionada: veredito (Sim/Em parte/Não), erros, janelas, frase do feriado só se os meses com feriado ganharem mais, e a previsão do mês seguinte. Medida de apresentação (Claude, ADR 0023).
	measure 'HTML Abertura 5' =
			VAR fmt = "pt-BR"
			VAR alvo = [Execucao Alvo]
			VAR wm = [WAPE Modelo]
			VAR wb = [WAPE Baseline]
			VAR v = COALESCE ( [Rodadas Vencidas], 0 )
			VAR test = [Rodadas Testadas]
			VAR prod = [Previsão Produção]
			VAR veredito = SWITCH ( TRUE (), v = test, "Sim", v * 2 >= test, "Em parte", "Não" )
			-- uma linha por janela testada da execução-alvo: mês, ganho e o feriado federal do mês (se houver)
			VAR meses =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( ml_backtest_metricas[mes_alvo] ),
			            "@g", CALCULATE ( AVERAGE ( ml_backtest_metricas[ganho_pp] ) ),
			            "@fer", VAR m = ml_backtest_metricas[mes_alvo]
			                RETURN CALCULATE ( MIN ( dim_tempo_hora[nome_feriado] ), REMOVEFILTERS ( dim_mes ), TREATAS ( { m }, dim_mes[ano_mes] ), dim_tempo_hora[is_feriado] = TRUE () ),
			            "@nome", VAR m = ml_backtest_metricas[mes_alvo]
			                RETURN LOWER ( FORMAT ( DATE ( VALUE ( LEFT ( m, 4 ) ), VALUE ( RIGHT ( m, 2 ) ), 1 ), "MMMM", "pt-BR" ) )
			        ),
			        ml_backtest_metricas[tipo] = "backtest",
			        dim_execucao[execucao] = alvo
			    )
			VAR g_fer = AVERAGEX ( FILTER ( meses, NOT ISBLANK ( [@fer] ) ), [@g] )
			VAR g_sem = AVERAGEX ( FILTER ( meses, ISBLANK ( [@fer] ) ), [@g] )
			VAR top_fer = TOPN ( 2, FILTER ( meses, NOT ISBLANK ( [@fer] ) && [@g] > 0 ), [@g], DESC )
			VAR top_geral = TOPN ( 1, FILTER ( meses, [@g] > 0 ), [@g], DESC )
			-- frase do feriado só quando os meses com feriado ganham mais; senão, o mês de maior vantagem (com 2+ janelas)
			VAR frase_fer =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( g_fer ) && NOT ISBLANK ( g_sem ) && g_fer > g_sem && NOT ISEMPTY ( top_fer ),
			            " A vantagem foi maior nos meses com feriado, como "
			                & CONCATENATEX ( top_fer, [@nome] & " (" & FORMAT ( [@g], "0.0", fmt ) & " pp)", " e ", [@g], DESC )
			                & ", que a média das semanas anteriores não enxerga.",
			        COUNTROWS ( meses ) > 1 && NOT ISEMPTY ( top_geral ),
			            " A maior vantagem foi em " & CONCATENATEX ( top_geral, [@nome] & " (" & FORMAT ( [@g], "0.0", fmt ) & " pp)" ) & ".",
			        ""
			    )
			VAR ini = MINX ( meses, ml_backtest_metricas[mes_alvo] )
			VAR fim = MAXX ( meses, ml_backtest_metricas[mes_alvo] )
			VAR d_ini = DATE ( VALUE ( LEFT ( ini, 4 ) ), VALUE ( RIGHT ( ini, 2 ) ), 1 )
			VAR d_fim = DATE ( VALUE ( LEFT ( fim, 4 ) ), VALUE ( RIGHT ( fim, 2 ) ), 1 )
			VAR periodo =
			    SWITCH (
			        TRUE (),
			        ini = fim, "em " & LOWER ( FORMAT ( d_fim, "MMMM", fmt ) ) & " de " & YEAR ( d_fim ),
			        YEAR ( d_ini ) = YEAR ( d_fim ),
			            "de " & LOWER ( FORMAT ( d_ini, "MMMM", fmt ) ) & " a " & LOWER ( FORMAT ( d_fim, "MMMM", fmt ) ) & " de " & YEAR ( d_fim ),
			        "de " & LOWER ( FORMAT ( d_ini, "MMM/yyyy", fmt ) ) & " a " & LOWER ( FORMAT ( d_fim, "MMM/yyyy", fmt ) )
			    )
			VAR frase_venc =
			    SWITCH (
			        TRUE (),
			        test = 1 && v = 1, "e venceu na única janela testada",
			        test = 1, "e não venceu na única janela testada",
			        v = 0, "e não venceu em nenhuma das " & test & " janelas",
			        v = test, "e venceu nas " & test & " janelas",
			        "e venceu em " & v & " das " & test & " janelas"
			    )
			VAR mp = CALCULATE ( MAX ( ml_backtest_metricas[mes_alvo] ), ml_backtest_metricas[tipo] = "producao", dim_execucao[execucao] = alvo )
			VAR frase_prod =
			    IF (
			        NOT ISBLANK ( prod ) && NOT ISBLANK ( mp ),
			        " Para " & LOWER ( FORMAT ( DATE ( VALUE ( LEFT ( mp, 4 ) ), VALUE ( RIGHT ( mp, 2 ) ), 1 ), "MMMM", fmt ) )
			            & ", o modelo prevê " & FORMAT ( prod / 1e6, "#,##0.0", fmt ) & " milhões de corridas."
			    )
			VAR texto =
			    IF (
			        ISBLANK ( test ),
			        "Ainda não há execução do modelo com janelas de backtest.",
			        veredito & ". O modelo errou " & FORMAT ( wm, "0.0%", fmt ) & " contra " & FORMAT ( wb, "0.0%", fmt )
			            & " do palpite sazonal (a média da mesma hora nas 4 semanas anteriores) " & frase_venc & ", " & periodo & "."
			            & frase_fer & frase_prod & " Esta raia não segue o filtro de período."
			    )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif'>"
			    & "<div style='font-size:20px;font-weight:700;color:#4B5D99'>RAIA 5 DE 5 · DÁ PARA PREVER A DEMANDA?</div>"
			    & "<div style='font-size:14px;line-height:1.45;color:#1F1F1F;margin-top:4px'>" & texto & "</div></div>"
		displayFolder: Apresentacao
		lineageTag: 07b7e7a2-4cd9-4403-abde-1fad29190fea

	/// Cartão de resposta 5 do cabeçalho (curto), da execução selecionada na raia 5: veredito, erros e janelas, com o selo da execução. Medida de apresentação (Claude, ADR 0023).
	measure 'HTML Resposta 5' =
			VAR fmt = "pt-BR"
			VAR v = COALESCE ( [Rodadas Vencidas], 0 )
			VAR test = [Rodadas Testadas]
			VAR e = [Execucao Alvo]
			VAR veredito = SWITCH ( TRUE (), v = test, "Sim", v * 2 >= test, "Em parte", "Não" )
			VAR venc =
			    SWITCH (
			        TRUE (),
			        test = 1 && v = 1, "vencendo na única janela testada",
			        v = 0, "sem vencer nenhuma janela testada",
			        v = test, "vencendo nas " & test & " janelas testadas",
			        "vencendo em " & v & " de " & test & " janelas"
			    )
			VAR texto =
			    IF (
			        ISBLANK ( test ),
			        "Ainda não há execução do modelo com janelas de backtest.",
			        veredito & ": erro de " & FORMAT ( [WAPE Modelo], "0.0%", fmt ) & " contra " & FORMAT ( [WAPE Baseline], "0.0%", fmt )
			            & " do palpite sazonal, " & venc & "."
			    )
			VAR selo = IF ( NOT ISBLANK ( e ), "Execução do modelo de " & MID ( e, 7, 2 ) & "/" & MID ( e, 5, 2 ) & "/" & LEFT ( e, 4 ) )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif'>"
			    & "<div style='font-size:12px;font-weight:700;color:#4B5D99'>5 · PREVISÃO</div>"
			    & "<div style='font-size:13px;line-height:1.35;color:#1F1F1F;margin:3px 0'>" & texto & "</div>"
			    & "<div style='font-size:10px;color:#605E5C'>" & selo & "</div></div>"
		displayFolder: Apresentacao
		lineageTag: dce36e43-97c6-4a8e-9262-555ddaef42fb

	/// Subtítulo do gráfico previsto × realizado por dia: o erro no total do dia na cidade ([WAPE Diario Cidade]) e o mês que só tem previsão. Medida de apresentação (Claude, ADR 0023).
	measure 'Subtitulo Previsto Realizado' =
			VAR alvo = [Execucao Alvo]
			VAR erro = [WAPE Diario Cidade]
			VAR mp = CALCULATE ( MAX ( ml_backtest_metricas[mes_alvo] ), ml_backtest_metricas[tipo] = "producao", dim_execucao[execucao] = alvo )
			VAR nome_mp = IF ( NOT ISBLANK ( mp ), LOWER ( FORMAT ( DATE ( VALUE ( LEFT ( mp, 4 ) ), VALUE ( RIGHT ( mp, 2 ) ), 1 ), "MMMM", "pt-BR" ) ) )
			VAR parte1 = IF ( NOT ISBLANK ( erro ), "No total do dia, o erro cai para " & FORMAT ( erro, "0.0%", "pt-BR" ) )
			VAR parte2 = IF ( NOT ISBLANK ( nome_mp ), nome_mp & " só tem a previsão" )
			RETURN
			    IF ( NOT ISBLANK ( parte1 ) && NOT ISBLANK ( parte2 ), parte1 & "; " & parte2, COALESCE ( parte1, parte2 ) )
		displayFolder: Apresentacao
		lineageTag: 90fb27a1-4b31-4de6-bbc8-29495b15b791

	/// A execução que as medidas usam: a selecionada na segmentação ou, sem seleção única, a padrão (dim_execucao[is_padrao]). Garante que nunca se somam execuções (ADR 0023; substitui o HASONEVALUE que devolvia vazio). Escrita pelo Claude.
	measure 'Execucao Alvo' =
			COALESCE (
			    SELECTEDVALUE ( dim_execucao[execucao] ),
			    CALCULATE ( MAX ( dim_execucao[execucao] ), REMOVEFILTERS ( dim_execucao ), dim_execucao[is_padrao] = TRUE () )
			)
		displayFolder: Base
		lineageTag: ae41df64-2384-44f2-8b43-e1b33e7b6b9d

